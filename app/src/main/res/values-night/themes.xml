<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.iFAFUKYZZ" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/claude_terracotta</item>
        <item name="colorPrimaryVariant">@color/claude_terracotta_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/claude_terracotta_light</item>
        <item name="colorSecondaryVariant">@color/claude_terracotta_300</item>
        <item name="colorOnSecondary">@color/claude_text_primary</item>
        <item name="android:statusBarColor">@color/claude_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/claude_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowBackground">@color/claude_bg</item>
        <item name="android:colorBackground">@color/claude_bg</item>
        <item name="android:textColorPrimary">@color/claude_text_primary</item>
        <item name="android:textColorSecondary">@color/claude_text_secondary</item>
        <item name="android:textColorHint">@color/claude_text_hint</item>
        <item name="android:windowAnimationStyle">@style/ClaudeWindowAnimation</item>
        <item name="android:fontFamily">@font/claude_serif</item>
        <!-- Map Material 3 color roles to the Claude palette so stock widgets
             (toggle groups, dialogs, switches, chips) never fall back to M3 lavender. -->
        <item name="colorPrimaryContainer">@color/claude_terracotta_100</item>
        <item name="colorOnPrimaryContainer">@color/claude_terracotta_800</item>
        <item name="colorSecondaryContainer">@color/claude_terracotta_100</item>
        <item name="colorOnSecondaryContainer">@color/claude_terracotta_800</item>
        <item name="colorTertiary">@color/claude_success</item>
        <item name="colorSurface">@color/claude_bg_elevated</item>
        <item name="colorOnSurface">@color/claude_text_primary</item>
        <item name="colorSurfaceVariant">@color/claude_bg_subtle</item>
        <item name="colorOnSurfaceVariant">@color/claude_text_secondary</item>
        <item name="colorSurfaceContainer">@color/claude_bg_elevated</item>
        <item name="colorSurfaceContainerLow">@color/claude_bg_elevated</item>
        <item name="colorSurfaceContainerHigh">@color/claude_bg_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/claude_bg_subtle</item>
        <item name="colorOutline">@color/claude_border</item>
        <item name="colorOutlineVariant">@color/claude_border_light</item>
        <item name="colorError">@color/claude_error</item>
        <item name="elevationOverlayEnabled">false</item>
    </style>

    <style name="ClaudeWindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>
